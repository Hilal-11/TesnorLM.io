{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shots": "node scripts/screenshots.mjs",
    "shots:tokens": "node scripts/screenshots.mjs /dev/tokens ../../docs/screenshots/phase1/p1.0 1440 390",
    "shots:components": "node scripts/screenshots.mjs /dev/components ../../docs/screenshots/phase1/components --sections",
    "db:types": "supabase gen types typescript --remote --schema public --workdir ../.. > src/lib/database.types.ts",
    "test:rls": "node scripts/vitest.mjs run --config vitest.rls.config.mts",
    "test:rls:local": "node scripts/with-local-supabase.mjs --test node scripts/vitest.mjs run --config vitest.rls.config.mts",
    "db:types:local": "supabase gen types typescript --local --schema public --workdir ../.. > src/lib/database.types.ts",
    "e2e": "playwright test",
    "dev:local": "node scripts/sync-pdfjs.mjs && node scripts/with-local-supabase.mjs --app next dev --port 3100",
    "e2e:local": "node scripts/with-local-supabase.mjs --e2e playwright test",
    "contract:sync": "node scripts/sync-contract.mjs",
    "predev": "node scripts/sync-env.mjs && node scripts/sync-contract.mjs && node scripts/sync-pdfjs.mjs",
    "prebuild": "node scripts/sync-env.mjs && node scripts/sync-contract.mjs && node scripts/sync-pdfjs.mjs",
    "pdfjs:sync": "node scripts/sync-pdfjs.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/openai": "^4.0.121",
    "@ai-sdk/react": "^4.0.181",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "@tanstack/react-table": "^9.3.1",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "ai": "^7.0.177",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "fractional-indexing": "^4.0.0",
    "inngest": "^4.26.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.75.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openai": "^7.60.0",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
