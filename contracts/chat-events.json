{
  "version": 1,
  "protocol": "tensorlm-chat",
  "contentType": "text/event-stream",
  "stages": {
    "thinking": "Thinking…",
    "searching_sources": "Reading your sources…",
    "searching_web": "Searching the web…",
    "writing": "Writing…"
  },
  "events": {
    "start": {
      "protocol": "int",
      "chatId": "uuid",
      "notebookId": "uuid?",
      "userMessageId": "uuid",
      "messageId": "uuid",
      "model": "string",
      "effort": "effort"
    },
    "status": { "stage": "stage", "detail": "string?" },
    "thinking_delta": { "text": "string" },
    "thinking_done": { "seconds": "number" },
    "tool_activity": {
      "id": "string",
      "kind": "toolKind",
      "query": "string",
      "resultCount": "int?"
    },
    "text_delta": { "blockIndex": "int", "text": "string" },
    "citation": { "blockIndex": "int", "citation": "citation" },
    "figure": {
      "figureId": "uuid",
      "url": "string",
      "label": "string",
      "page": "int?",
      "documentId": "uuid"
    },
    "notice": { "code": "notice" },
    "usage": {
      "inputTokens": "int",
      "outputTokens": "int",
      "cacheReadTokens": "int",
      "cacheWriteTokens": "int",
      "webSearches": "int",
      "costUsd": "number"
    },
    "done": { "messageId": "uuid", "stopReason": "stopReason" },
    "error": {
      "code": "error",
      "message": "string",
      "fix": "string",
      "retryable": "boolean"
    },
    "followups": { "messageId": "uuid", "questions": "string[]" },
    "title": { "chatId": "uuid", "title": "string" }
  },
  "efforts": ["low", "medium", "high", "xhigh", "max"],
  "toolKinds": ["sources", "web"],
  "stopReasons": [
    "end_turn",
    "stop_sequence",
    "max_tokens",
    "refusal",
    "max_rounds",
    "stopped",
    "interrupted",
    "error",
    "unknown"
  ],
  "citationKinds": ["source", "web"],
  "notices": {
    "no_citations": "This answer has no citations. Check it against your sources.",
    "max_rounds": "TensorLM stopped searching after several tries. The answer uses what it found.",
    "refusal": "Claude didn't answer this request.",
    "length_limit": "Reached the length limit.",
    "model_changed": "New model applies from your next message."
  },
  "errors": {
    "rate_limited": {
      "message": "TensorLM is busy right now.",
      "fix": "Try again in a moment.",
      "retryable": true
    },
    "spend_limited": {
      "message": "TensorLM is temporarily unavailable.",
      "fix": "Please try again later.",
      "retryable": false
    },
    "overloaded": {
      "message": "Claude is busy right now.",
      "fix": "Try again in a moment.",
      "retryable": true
    },
    "timeout": {
      "message": "The answer took too long to start.",
      "fix": "Try again.",
      "retryable": true
    },
    "unavailable": {
      "message": "TensorLM can't reach Claude right now.",
      "fix": "Please try again later.",
      "retryable": false
    },
    "too_large": {
      "message": "This chat is too long to continue.",
      "fix": "Start a new chat to keep going.",
      "retryable": false
    },
    "bad_request": {
      "message": "We couldn't send that message.",
      "fix": "Try rephrasing it, or start a new chat.",
      "retryable": false
    },
    "interrupted": {
      "message": "The answer was interrupted.",
      "fix": "Continue to finish it.",
      "retryable": true
    },
    "user_rate_limited": {
      "message": "You've asked a lot of questions in a short time.",
      "fix": "Try again in a few minutes.",
      "retryable": true
    },
    "web_search_limit": {
      "message": "You've used today's web searches.",
      "fix": "Ask without web search, or try again tomorrow.",
      "retryable": false
    },
    "internal": {
      "message": "We couldn't finish this answer.",
      "fix": "Try again.",
      "retryable": true
    }
  },
  "limits": {
    "maxMessageChars": 8000,
    "maxImagesPerMessage": 4,
    "imageMaxLongEdgePx": 2576,
    "maxToolRounds": 4,
    "maxSourceSearchesPerRound": 3,
    "followupCount": 3,
    "followupMaxChars": 60,
    "suggestedQuestionsMin": 4,
    "suggestedQuestionsMax": 5,
    "suggestedQuestionMaxChars": 90,
    "citedTextPreviewChars": 300
  }
}
