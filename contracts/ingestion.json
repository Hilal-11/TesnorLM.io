{
  "version": 1,
  "stages": [
    "uploading",
    "queued",
    "validating",
    "parsing",
    "ocr",
    "reading_figures",
    "indexing",
    "ready",
    "failed"
  ],
  "transitions": {
    "uploading": ["queued", "failed"],
    "queued": ["validating", "failed"],
    "validating": ["parsing", "failed"],
    "parsing": ["ocr", "reading_figures", "indexing", "failed"],
    "ocr": ["reading_figures", "indexing", "failed"],
    "reading_figures": ["indexing", "failed"],
    "indexing": ["ready", "failed"],
    "ready": [],
    "failed": []
  },
  "uiWords": {
    "uploading": "Uploading",
    "queued": "Queued",
    "validating": "Reading",
    "parsing": "Reading",
    "ocr": "Reading",
    "reading_figures": "Reading",
    "indexing": "Indexing",
    "ready": "Ready",
    "failed": "Failed"
  },
  "details": {
    "uploading": {
      "template": "Uploading · {percent}%",
      "fallback": "Uploading",
      "vars": ["percent"]
    },
    "queued": { "template": "Waiting to start" },
    "validating": { "template": "Checking the file" },
    "parsing": {
      "template": "Reading page {page} of {pages}",
      "fallback": "Reading the pages",
      "vars": ["page", "pages"]
    },
    "ocr": {
      "template": "Running OCR on page {page} of {pages}",
      "fallback": "Running OCR",
      "vars": ["page", "pages"]
    },
    "reading_figures": {
      "template": "Reading figures · {done} of {total}",
      "fallback": "Reading figures",
      "vars": ["done", "total"]
    },
    "indexing": {
      "template": "Indexing {passages} {passages:passage|passages}",
      "fallback": "Indexing passages",
      "vars": ["passages"]
    },
    "ready": {
      "template": "{pages} {pages:page|pages} · Ready",
      "fallback": "Ready",
      "vars": ["pages"]
    }
  },
  "actions": {
    "retry": "Try again",
    "resume_upload": "Resume upload",
    "open_existing": "Open it",
    "add_anyway": "Add anyway"
  },
  "errors": {
    "not_pdf": {
      "message": "This file isn't a PDF.",
      "fix": "Choose a PDF file instead.",
      "autoRetry": false
    },
    "file_too_large": {
      "message": "This file is {sizeMb} MB. The limit is {limitMb} MB.",
      "fallback": "This file is over the size limit.",
      "fix": "Split the PDF or upload chapters separately.",
      "vars": ["sizeMb", "limitMb"],
      "autoRetry": false
    },
    "too_many_pages": {
      "message": "This PDF has {pages} pages. The limit is {limit} {limit:page|pages}.",
      "fallback": "This PDF has more pages than the limit.",
      "fix": "Upload chapters separately.",
      "vars": ["pages", "limit"],
      "autoRetry": false
    },
    "encrypted_pdf": {
      "message": "This PDF is password-protected.",
      "fix": "Remove the password and upload it again.",
      "autoRetry": false
    },
    "corrupt_pdf": {
      "message": "This PDF looks damaged and can't be opened.",
      "fix": "Re-download or re-export the PDF, then try again.",
      "autoRetry": false
    },
    "no_text_found": {
      "message": "We couldn't find readable text, even with OCR.",
      "fix": "Upload a clearer scan.",
      "autoRetry": false
    },
    "parse_timeout": {
      "message": "This PDF took too long to read.",
      "fix": "Try again, or upload it in smaller parts.",
      "actions": ["retry"],
      "autoRetry": false
    },
    "quota_exceeded": {
      "message": "This notebook has reached its limit of {limit} sources.",
      "fallback": "This notebook has reached its source limit.",
      "fix": "Remove a source, then add this one.",
      "vars": ["limit"],
      "autoRetry": false
    },
    "duplicate_file": {
      "message": "This paper is already in this notebook.",
      "fix": "Open the copy you added, or add it again anyway.",
      "actions": ["open_existing", "add_anyway"],
      "autoRetry": false
    },
    "upload_interrupted": {
      "message": "The upload stopped.",
      "fix": "Check your connection, then resume the upload.",
      "actions": ["resume_upload"],
      "autoRetry": false
    },
    "internal": {
      "message": "We couldn't finish reading this file.",
      "fix": "Try again in a moment.",
      "actions": ["retry"],
      "autoRetry": true
    }
  },
  "events": {
    "uploaded": "document/uploaded",
    "reprocess": "document/reprocess",
    "deleted": "document/deleted",
    "notebookDeleted": "notebook/deleted"
  },
  "limits": {
    "maxUploadMb": 50,
    "maxPages": 200,
    "maxFilesPerBatch": 10,
    "maxParallelUploads": 3,
    "maxSourcesFree": 20
  },
  "storage": {
    "bucket": "documents",
    "artifactsBucket": "ingest-artifacts",
    "paths": {
      "source": "{userId}/{documentId}/source.pdf",
      "figure": "{userId}/{documentId}/figures/{runId}/{n}.webp",
      "parsed": "{userId}/{documentId}/{runId}/doc.json"
    }
  }
}
