# ───────────── Supabase ─────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose to browser

# Public URL of the web app (auth emails and OAuth redirect here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile site key (bot check on sign-up and password reset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ───────────── LLMs ─────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5          # main model for answers / lessons
OPENAI_API_KEY=sk-...                # used for embeddings
EMBEDDING_MODEL=text-embedding-3-small   # 1536 dims (matches the SQL schema)

# ───────────── Worker (Python parsing service) ─────────────
WORKER_URL=http://localhost:8000
WORKER_SECRET=change-me-to-a-long-random-string

# ───────────── Ingestion (phase 3) — see docs/specs/ingestion.md ─────────────
# Inngest: leave both keys empty locally and set INNGEST_DEV=1 (remove it in production)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
# Vision model for figure captions (worker)
FAST_MODEL=claude-haiku-5-5
# Limits enforced by the API and the worker (defaults in contracts/ingestion.json)
MAX_UPLOAD_MB=50
MAX_PAGES=200
MAX_SOURCES_FREE=20
PARSE_TIMEOUT_S=600
# Optional: where the worker finds contracts/ingestion.json (found automatically in the repo)
# INGESTION_CONTRACT_PATH=

# ───────────── Later (phase 2) ─────────────
# COHERE_API_KEY=            # reranking
# E2B_API_KEY=               # code sandbox for worked examples
# LANGFUSE_PUBLIC_KEY=       # tracing / cost tracking
# LANGFUSE_SECRET_KEY=
# UPSTASH_REDIS_REST_URL=    # cache + rate limit
# UPSTASH_REDIS_REST_TOKEN=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
